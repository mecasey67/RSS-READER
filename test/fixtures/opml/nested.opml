<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head><title>Nested Subscriptions</title></head>
  <body>
    <outline text="News" title="News">
      <outline text="Local" title="Local">
        <outline text="Local Paper" title="Local Paper" type="rss" xmlUrl="https://localpaper.example.com/feed" htmlUrl="https://localpaper.example.com" />
      </outline>
      <outline text="World News" title="World News" type="rss" xmlUrl="https://worldnews.example.com/feed" htmlUrl="https://worldnews.example.com" />
    </outline>
  </body>
</opml>
