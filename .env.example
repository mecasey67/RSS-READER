# Copy this file to .env.local for local development, or provide these as
# real environment variables (e.g. via Docker Compose) in production.

# --- Database -----------------------------------------------------------
# Path to a SQLite database file, or ":memory:" for an ephemeral in-process
# database (used by the test suite). Defaults to ./data/dev.db.
DATABASE_URL=./data/dev.db

# --- Authentication -------------------------------------------------------
# If unset, the app runs with NO login screen — fine for local development,
# unsafe for anything reachable over a network. Set both of these to enable
# a single-admin-password login gate before deploying anywhere public.
# ADMIN_PASSWORD=change-me
# Generate with: openssl rand -base64 32
# SESSION_SECRET=

# Email used for the single seeded admin user (cosmetic only in v1).
# ADMIN_EMAIL=admin@localhost

# --- Feed fetching --------------------------------------------------------
# Sent as the HTTP User-Agent header on every feed request.
USER_AGENT=ModernRSSReader/1.0 (+self-hosted feed reader)
# Per-request timeout, in milliseconds.
FETCH_TIMEOUT_MS=15000
# Maximum decompressed feed response size, in bytes (guards against
# decompression bombs / runaway feeds).
MAX_FEED_SIZE=10485760
# Maximum OPML upload size, in bytes.
MAX_OPML_SIZE=10485760
# How many feeds may be fetched concurrently.
FETCH_CONCURRENCY=4

# Set to "true" to allow fetching feeds from localhost/private IP ranges.
# Leave unset in any deployment reachable from untrusted users — this is an
# SSRF protection escape hatch intended only for local/offline feed testing.
# ALLOW_LOCAL_FEEDS=false

# --- Scheduler --------------------------------------------------------
# Target refresh interval for a healthy feed, in minutes. Failing feeds back
# off exponentially from this baseline (see src/jobs/refresh.ts).
FEED_REFRESH_INTERVAL=20
# How often the background scheduler checks for due feeds, in milliseconds.
SCHEDULER_TICK_MS=60000
# Set to "true" to disable the background scheduler entirely (e.g. if you
# want to trigger refreshes only via an external cron hitting a script).
# DISABLE_SCHEDULER=false
